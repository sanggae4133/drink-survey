# 복사해서 .env로 저장하고 run.sh가 읽게 하거나, systemd EnvironmentFile로 지정
# ---------------------------------------------------------------
# 세션 서명 키 — 운영에서는 반드시 무작위 값으로 (python -c "import secrets;print(secrets.token_hex(32))")
SESSION_SECRET=change-me

# Google OAuth: GCP 콘솔 → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID(웹)
# 승인된 리디렉션 URI에 https://<기기명>.<tailnet>.ts.net/auth/callback 추가
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 회사 도메인 (예: company.co.kr). 이 도메인 이메일만 로그인 허용. 비우면 검증 생략(개발용).
ALLOWED_DOMAIN=

# 1이면 로그인 화면에 dev 로그인 노출(구글 없이 등록된 이메일로 로그인). 운영은 0.
DEV_LOGIN=1

# DB 파일 경로 (기본: 프로젝트 루트의 drink_survey.db)
#DB_PATH=/home/pi/drink-survey/drink_survey.db
